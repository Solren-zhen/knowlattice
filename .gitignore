# 构建产物
dist/
.pack-staging/

# 依赖
node_modules/

# 历史快照
*.zip

# 离线便携包解压出来的目录（62MB 构建产物，靠 npm run pack 随时重出）
KnowLattice-离线版-*/
# zip 内层的顶层目录名：在仓库根目录「解压到当前文件夹」时会解出这个（同一份构建产物）
KnowLattice-Portable/

# 下载残留
*.qkdownloading

# 系统文件
Thumbs.db
.DS_Store

# 编辑器会话产物
.zcode/
.zcodeignore

# 浏览器自动化会话产物
.playwright-mcp/

# 代码分析产物
.ua/

# DSH Desktop 的工作文件（被占用删不掉，也不属于本项目；留着会让 git status 永远脏）
token-cost-calc.univer
verify2.univer
# DSH 工具在仓库根落的临时目录（同上，属宿主产物）
.dsh-tmp/

# Python 字节码（离线包里的 server.py 是 Python 了，本地跑一次就会生成）
__pycache__/
*.pyc

# 视觉审计工作区（截图 harness / 基线图 / 演示数据，均本地生成）
.shots/

# 用户交付物（笔记/题库备份 .json，属本地数据，不入库）
knowlattice-导入-*.json
# 题库导入包（脚本按需生成，几十 MB，不入库）
knowlattice-题库/
knowlattice-题库-*.json
knowlattice-题库-*.md

# 本地分析文档（决策留档，不入库）
四功能可行性分析.md
审计报告-*.md

# 本机内容包 / 上传缓存 / 代理工作目录（体积大，运行时生成）
content-packs/
.dsh-uploads/
.yanagent/

# 根目录视觉审计截图（临时产物，已由 .shots/ 统一承载）
/home-map-*.png
/settings-after*.png

# 运行日志（dev server 持续写入，入库会让 git status 永远脏）
*.log

# 测试排查产物（vitest --reporter=json 生成，内容带真实绝对路径）
vitest-report.json

# 构建前从 node_modules 同步的 pdf.js worker（见 scripts/copy-pdf-worker.mjs）
public/pdfjs/

# Tauri 桌面壳构建产物
src-tauri/target/
src-tauri/gen/

# 更新签名私钥（泄露=任何人可推假更新，务必别提交）
src-tauri/private.key
src-tauri/*.key*
# 更新器元数据（发版产物，由 scripts/pack/make-latest-json.mjs 本地生成）
/latest.json

# 医考素材归档（安装包原件 + 解包副本 + 医记通样本，约 390MB，本地留存不入库）
med-archive/sources/

# 速查/图集生成物与本地图片（node tools/ingest-app-data.mjs 可再生成）
public/app-data/

# 只作资料分享、不进构建的素材
med-archive/share-only/**
!med-archive/share-only/README.md

# 本机分析副本与调研抓取物（target.work / .work 里是第三方镜像，不入库、不参与 lint）
.work/
