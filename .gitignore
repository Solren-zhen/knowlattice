# 构建产物
dist/

# 依赖
node_modules/

# 历史快照
*.zip

# 离线便携包解压出来的目录（62MB 构建产物，靠 npm run pack 随时重出）
KnowLattice-离线版-*/
# zip 内层的顶层目录名：在仓库根目录「解压到当前文件夹」时会解出这个（同一份构建产物）
KnowLattice-Portable/

# 下载残留
*.qkdownloading

# 系统文件
Thumbs.db
.DS_Store

# 编辑器会话产物
.zcode/

# Yan Agent 会话产物
.yanagent/

# 代码图谱索引（本地工具产物，约 17MB）
.codegraph/

# 浏览器自动化会话产物
.playwright-mcp/

# 代码分析产物
.ua/

# 视觉审计工作区（截图 harness / 基线图 / 演示数据，均本地生成）
.shots/

# 用户交付物（笔记/题库备份 .json，属本地数据，不入库）
knowlattice-导入-*.json
# 题库导入包（脚本按需生成，几十 MB，不入库）
knowlattice-题库/
knowlattice-题库-*.json
knowlattice-题库-*.md

# 运行日志（dev server 持续写入，入库会让 git status 永远脏）
*.log
