{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnowLattice",
  "version": "0.2.0",
  "identifier": "com.jophy.knowlattice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "晶格 · KnowLattice",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' data:; media-src 'self' asset: https://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost https:; worker-src 'self' blob:; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2OEVFRjNERDY2RTVDNDEKUldSQlhHN1dQZStPNW5nMlRnVi8wZlBSNElCK0FrTGI0V1EzMjNBTW5Ld0ZLQjBlM0tlSlFkNlYK",
      "endpoints": [
        "https://github.com/Solren-zhen/knowlattice/releases/latest/download/latest.json"
      ]
    }
  }
}
